{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "humantaste",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "humantaste.xyz", "custom_domain": true }],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "browser": { "binding": "BROWSER", "remote": true },
  "media": { "binding": "MEDIA", "remote": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "humantaste",
      "database_id": "485e04b2-b0f3-4f3e-98b7-ac0887aa166c",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "SHOTS", "bucket_name": "humantaste-shots" }],
  "kv_namespaces": [
    { "binding": "SKILL_STARS", "id": "08bcbe81a0b245ae891882e562a6bcba" },
  ],
  "durable_objects": {
    "bindings": [{ "name": "SITE_SCAN", "class_name": "SiteScan" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteScan"] }],
  "ratelimits": [
    {
      "name": "SCAN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
}
